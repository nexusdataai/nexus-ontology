# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=
AWS_PROFILE=external-access

# Active Directory / ADFS Login (for aws-login.sh)
AD_USERNAME=
AD_PASSWORD=

# Build Configuration
SKIP_TESTS=false
SKIP_SCAN=false
SKIP_PUSH=false
NO_CACHE=false

# Security Scanning
SCAN_SEVERITY_THRESHOLD=CRITICAL
