# ============================================================================
# Nexus Telco UI - Environment Configuration
# ============================================================================
# Copy this file to .env.local and fill in the values for local development.
#
# Configuration Priority (for local development):
#   1. Environment variables (.env.local) - checked first
#   2. /public/config.json - fallback
#   3. Default values - last resort
#
# For production, configuration is loaded from /public/config.json which
# can be generated from SSM parameters at deploy time.
# ============================================================================

# ============================================================================
# API Configuration
# ============================================================================

# Backend API URL (required)
# For local development with the backend gateway running:
VITE_API_BASE_URL=http://localhost:8000

# API request timeout in milliseconds (optional, default: 30000)
VITE_API_TIMEOUT=30000

# ============================================================================
# Authentication Configuration
# ============================================================================

# OPTION 1: Bypass authentication (recommended for local development)
# Set to 'true' to skip Cognito authentication entirely
VITE_BYPASS_AUTH=true

# OPTION 2: Use Cognito authentication (for testing auth flows)
# Uncomment and fill in these values if you need authentication:

# AWS Cognito User Pool ID (format: region_poolId)
# VITE_COGNITO_USER_POOL_ID=ap-southeast-1_7LY6LuRjQ

# AWS Cognito Client ID (App client ID from Cognito)
# VITE_COGNITO_CLIENT_ID=75q3tqoe1krqt63h7k4d99f9a0

# AWS Cognito Domain (without https://)
# VITE_COGNITO_DOMAIN=call-processing-prod-764119721991.auth.ap-southeast-1.amazoncognito.com

# AWS Region (auto-detected from userPoolId if not set)
# VITE_AWS_REGION=ap-southeast-1

# OAuth Redirect URLs (auto-detected from window.location if not set)
# VITE_OAUTH_REDIRECT_SIGNIN=http://localhost:5173/auth/callback
# VITE_OAUTH_REDIRECT_SIGNOUT=http://localhost:5173/login

# ============================================================================
# Data Source Configuration
# ============================================================================

# Data source: 'api' (live backend) or 'json' (local mock files)
# Use 'json' if you want to test UI without backend
VITE_DATA_SOURCE=api

# Enable fallback to mock data if API fails (default: true)
VITE_ENABLE_FALLBACK=true

# ============================================================================
# Optional: OpenAI Integration (for AI chatbot features)
# ============================================================================

# OpenAI API Key (optional - for AI-powered chatbot)
# VITE_OPENAI_API_KEY=sk-your-openai-api-key

# ============================================================================
# Optional: Supabase Integration (if using Supabase backend)
# ============================================================================

# ============================================================================
# Example Configurations
# ============================================================================

# ----- LOCAL DEVELOPMENT (No Auth, Local API) -----
# VITE_API_BASE_URL=http://localhost:8000
# VITE_BYPASS_AUTH=true
# VITE_DATA_SOURCE=api

# ----- LOCAL DEVELOPMENT (Mock Data, No Backend) -----
# VITE_BYPASS_AUTH=true
# VITE_DATA_SOURCE=json
# VITE_ENABLE_FALLBACK=true

# ----- LOCAL DEVELOPMENT (With Cognito Auth) -----
# VITE_API_BASE_URL=http://localhost:8000
# VITE_BYPASS_AUTH=false
# VITE_COGNITO_USER_POOL_ID=ap-southeast-1_7LY6LuRjQ
# VITE_COGNITO_CLIENT_ID=75q3tqoe1krqt63h7k4d99f9a0
# VITE_COGNITO_DOMAIN=call-processing-prod-764119721991.auth.ap-southeast-1.amazoncognito.com
# VITE_OAUTH_REDIRECT_SIGNIN=http://localhost:5173/auth/callback
# VITE_OAUTH_REDIRECT_SIGNOUT=http://localhost:5173/login

# ----- CONNECT TO PRODUCTION API (with auth bypass for testing) -----
# VITE_API_BASE_URL=https://call-api.totogicore.com
# VITE_BYPASS_AUTH=true
# VITE_DATA_SOURCE=api
