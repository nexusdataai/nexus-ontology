# K3s local dev — copy to .env.local:
#   cp .env.local.k3s.example .env.local
#
# Requires host-run backend on port 8000 (see backend/.env.local.k3s.example).
# API calls use same-origin URLs (empty baseUrl) — Vite proxies /api to :8000.
# Do NOT set VITE_API_BASE_URL=http://localhost:8000 when accessing UI via
# the server's IP (e.g. 10.x.x.x:8080) — localhost would point at your laptop.

VITE_API_BASE_URL=
VITE_API_TIMEOUT=30000
VITE_BYPASS_AUTH=true
VITE_DATA_SOURCE=api
VITE_ENABLE_FALLBACK=true
