# =============================================================================
# Nexus Ontology — K3s local dev (host-run backend + port-forwarded services)
# =============================================================================
# Copy to .env.local before starting mcp_http_gateway.py:
#   cp .env.local.k3s.example .env.local
#
# Prerequisites:
#   nexus-deployer: set-context.sh 6, local-k3s/deploy-local-aws-stack.sh
#   kubectl apply -f kube-operator/examples/nexus-ontology-local-dev-deps.yaml
#   ./scripts/port-forward-k3s-dev.sh
# =============================================================================

# --- Mode switch ---
USE_LOCALSTACK=true
LOCALSTACK_HOST=127.0.0.1
LOCALSTACK_PORT=4566
ENVIRONMENT=local
CAPABILITY_NAME=ontology
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Split endpoints (K3s hybrid — Scylla DDB on :8001, backend gateway on :8000)
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8001
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
AWS_DISABLE_EXPLICIT_SERVICE_ENDPOINTS=false

# --- Capability + environment (table/bucket names derive from these) ---
# DynamoDB: {CAPABILITY_NAME}-{ENVIRONMENT}-{purpose}
#   e.g. ontology-local-foundry-workspace  (local K3s, ENVIRONMENT=local)
#        ontology-dev-foundry-workspace      (remote K8 dev, ENVIRONMENT=dev)
# Glue DB:  {capability}_{environment}_db  → ontology_local_db
# S3 buckets: {capability}-{environment}-{purpose}[-{account_id}]
# Local account id appended to S3 bucket names by init job / operator
LOCAL_AWS_ACCOUNT_ID=000000000000
# Optional explicit overrides (match local init job bucket names):
# S3_JOURNEY_LOGS_BUCKET=ontology-local-journey-logs-000000000000
# S3_JOURNEY_REPORTS_BUCKET=ontology-local-journey-reports-000000000000

# --- Glue / Athena (optional — defaults to ontology_local_db from CAPABILITY+ENV) ---
GLUE_DATABASE=ontology_local_db

# --- Control plane (postgres / semantic RAG) ---
FDW_PG_HOST=127.0.0.1
FDW_PG_PORT=5432
FDW_PG_DATABASE=ontology_cp
FDW_PG_USER=nexus
FDW_PG_PASSWORD=nexus
FDW_PG_SCHEMA=public

REDIS_URL=redis://127.0.0.1:6379/0
MIMIR_URL=http://127.0.0.1:9090
MIMIR_ENABLED=true

# --- Remote nexus-simulator (required; ontology is a client only) ---
SIMULATOR_ENABLED=true
SIMULATOR_BASE_URL=http://simulator-local-backend-svc-internal.simulator-local.svc.cluster.local:8000
SIMULATOR_UI_URL=http://localhost:8082

# --- Gateway / auth (local UI bypass) ---
API_KEY=super-secret
GATEWAY_PORT=8000
LOG_LEVEL=DEBUG

# Do not use AWS_PROFILE here — K3s set-context exports AWS_PROFILE=local for kubectl only.
# Host-run backend uses minioadmin keys above; unset profile in your shell if needed:
#   unset AWS_PROFILE

# Cognito off for local
ENABLE_COGNITO=false
